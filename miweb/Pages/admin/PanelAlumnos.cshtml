@page
@model miweb.Pages.admin.PanelAlumnosModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container mt-4" style="color: white; background-color: #121212; padding: 25px; border-radius: 8px;">
    <h2 class="text-success mb-4">⚽ Panel de Control - Academia de Fútbol</h2>

    <div class="card bg-dark text-white mb-4 border-secondary">
        <div class="card-header bg-secondary"><strong>➕ Registrar Alumno Directamente</strong></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Agregar">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <label>Nombre Completo:</label>
                        <input type="text" asp-for="AlumnoInput.NombreCompleto" class="form-control bg-dark text-white" required />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label>DNI:</label>
                        <input type="text" asp-for="AlumnoInput.Dni" class="form-control bg-dark text-white" maxlength="8" required />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label>Celular:</label>
                        <input type="text" asp-for="AlumnoInput.Celular" class="form-control bg-dark text-white" required />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label>Edad:</label>
                        <input type="number" asp-for="AlumnoInput.Edad" class="form-control bg-dark text-white" min="1" required />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label>Día de Pago (DD-MM):</label>
                        <input type="text" asp-for="AlumnoInput.FechaPago" class="form-control bg-dark text-white" placeholder="Ej: 14-06" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-success mt-2">Guardar Alumno</button>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover align-middle">
            <thead>
                <tr class="table-success text-dark">
                    <th>Nombre Completo</th>
                    <th>DNI</th>
                    <th>Celular</th>
                    <th>Edad</th>
                    <th>Último Pago</th>
                    <th class="text-warning">Próximo Pago</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ListaAlumnos != null && Model.ListaAlumnos.Any())
                {
                    foreach (var alumno in Model.ListaAlumnos)
                    {
                        <tr>
                            <td>@alumno.NombreCompleto</td>
                            <td>@alumno.Dni</td>
                            <td>@alumno.Celular</td>
                            <td>@alumno.Edad años</td>
                            <td>📅 @(string.IsNullOrEmpty(alumno.FechaPago) ? "Sin registro" : alumno.FechaPago)</td>
                            <td class="text-warning fw-bold">📅 @Model.CalcularProximoPago(alumno.FechaPago)</td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-warning btn-sm text-dark fw-bold" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalEditar"
                                            onclick="cargarDatos('@alumno.Id', '@alumno.NombreCompleto', '@alumno.Dni', '@alumno.Celular', '@alumno.Edad', '@alumno.FechaPago')">
                                        📝 Editar
                                    </button>

                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@alumno.Id" 
                                          onsubmit="return confirm('¿Seguro que deseas eliminar a este alumno?');">
                                        <button type="submit" class="btn btn-danger btn-sm">❌ Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No hay alumnos registrados aún.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-3">
        <a asp-page="/Index" class="btn btn-outline-light">Volver al Inicio</a>
    </div>
</div>

<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header bg-secondary">
                <h5 class="modal-title">📝 Editar Ficha del Alumno</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Editar">
                <div class="modal-body">
                    <input type="hidden" id="editId" asp-for="AlumnoInput.Id" />

                    <div class="mb-3">
                        <label class="form-label">Nombre Completo:</label>
                        <input type="text" id="editNombre" asp-for="AlumnoInput.NombreCompleto" class="form-control bg-secondary text-white" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">DNI:</label>
                        <input type="text" id="editDni" asp-for="AlumnoInput.Dni" class="form-control bg-secondary text-white" maxlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Celular:</label>
                        <input type="text" id="editCelular" asp-for="AlumnoInput.Celular" class="form-control bg-secondary text-white" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Edad:</label>
                        <input type="number" id="editEdad" asp-for="AlumnoInput.Edad" class="form-control bg-secondary text-white" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Día de Pago (DD-MM):</label>
                        <input type="text" id="editFecha" asp-for="AlumnoInput.FechaPago" class="form-control bg-secondary text-white" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function cargarDatos(id, nombre, dni, celular, edad, fecha) {
        document.getElementById('editId').value = id;
        document.getElementById('editNombre').value = nombre;
        document.getElementById('editDni').value = dni;
        document.getElementById('editCellular').value = celular;
        document.getElementById('editEdad').value = edad;
        document.getElementById('editFecha').value = fecha;
    }
</script>