@page
@model miweb.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio - Academia de Fútbol";
}

<div class="container mt-5" style="max-width: 900px;">
    
    @if (Model.ErrorDni != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
            ❌ @Model.ErrorDni
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card p-4 shadow-sm" style="border-top: 5px solid #198754;">
                <h4 class="mb-3 text-success">✍️ ¿Eres Nuevo? ¡Inscríbete!</h4>
                <p class="text-muted small">Ingresa tus datos oficiales para separar tu cupo.</p>
                
                <form method="post" asp-page-handler="Registrar">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Nombre Completo:</label>
                        <input type="text" asp-for="NuevoAlumno.NombreCompleto" class="form-control" placeholder="Ej. Juan Carlos" required>
                    </div>
                    
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label font-weight-bold">DNI:</label>
                            <input type="text" asp-for="NuevoAlumno.Dni" class="form-control" placeholder="8 dígitos" maxlength="8" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label font-weight-bold">Celular:</label>
                            <input type="text" asp-for="NuevoAlumno.Celular" class="form-control" placeholder="Ej. 999333222" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Edad:</label>
                        <input type="number" asp-for="NuevoAlumno.Edad" class="form-control" min="1" required>
                    </div>

                    <div class="mb-4 p-2 bg-light rounded d-flex justify-content-between align-items-center">
                        <span class="text-muted">Costo Inscripción:</span>
                        <strong class="text-success">S/ 109.00</strong>
                    </div>

                    <button type="submit" class="btn btn-success w-100 font-weight-bold">Registrar Inscripción ➡️</button>
                </form>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card p-4 shadow-sm" style="border-top: 5px solid #0d6efd;">
                <h4 class="mb-3 text-primary">⚽ Alumnos de la Academia</h4>
                <p class="text-muted small">Ingresa tu número de DNI para verificar asistencias y pagos.</p>
                
                <form method="post" asp-page-handler="Consultar" class="mt-4">
                    <div class="mb-4">
                        <label class="form-label font-weight-bold">Ingresa tu DNI Registrado:</label>
                        <input type="text" name="dniIngresado" class="form-control form-control-lg text-center" placeholder="70961785" maxlength="8" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg font-weight-bold">Consultar Ficha Deportiva 🔍</button>
                </form>
            </div>
        </div>
    </div>
</div>