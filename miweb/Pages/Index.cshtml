@page
@model IndexModel
@{
    ViewData["Title"] = "Academia de Fútbol PJ";
}

<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

<div class="container px-2 px-md-3" style="max-width: 1000px; margin-top: 15px; font-family: 'Segoe UI', sans-serif;">
    
    <div class="text-center p-3 p-md-4 mb-3 bg-white rounded-3 shadow-sm border">
        <img src="~/images/logo.png" alt="Logo Academia PJ" style="max-height: 110px; object-fit: contain;" class="mb-2">
        <h1 class="fw-bold text-dark m-0" style="font-size: 1.8rem; letter-spacing: -0.5px;">ACADEMIA DE FÚTBOL PJ</h1>
        <span class="badge bg-dark mt-2 px-3 py-1.5 fs-7">Categoría Adultos (+18)</span>
        <div class="mt-2 text-secondary small">📍 Sede: @Model.DireccionAcademia</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeAlerta))
    {
        <div class="alert alert-@Model.TipoAlerta alert-dismissible fade show text-center mb-3 small py-2" role="alert">
            @Model.MensajeAlerta
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.AccesoConcedido && !IndexModel.EsAdminSesion && string.IsNullOrEmpty(Model.WhatsappUrl))
    {
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card shadow-sm p-3 bg-light border-0 h-100" style="border-radius: 12px; border-top: 4px solid #38ef7d !important;">
                    <h4 class="fw-bold mb-1 fs-5">✍️ ¿Eres Nuevo? ¡Inscríbete!</h4>
                    <p class="text-muted small mb-3">Ingresa tus datos oficiales para separar tu cupo.</p>
                    
                    <form method="post" asp-page-handler="Inscribir">
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">Nombre Completo:</label>
                            <input type="text" asp-for="NuevoNombre" class="form-control form-control-sm" placeholder="Ej. Juan Carlos" required />
                        </div>
                        
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">DNI:</label>
                                <input type="text" asp-for="NuevoDni" class="form-control form-control-sm" placeholder="8 dígitos" maxlength="8" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">Celular:</label>
                                <input type="text" asp-for="NuevoCelular" class="form-control form-control-sm" placeholder="Ej. 999333222" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">Edad (+18):</label>
                            <input type="number" asp-for="NuevoEdad" class="form-control form-control-sm" placeholder="Ej. 20" min="18" required />
                        </div>

                        <div class="p-2 bg-white rounded border mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted fw-bold">Costo Inscripción:</span>
                                <span class="text-success fw-bold">S/ @Model.MontoInscripcion.00</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold py-2">Registrar Inscripción ➡️</button>
                    </form>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm p-3 bg-white h-100" style="border-radius: 12px; border-top: 4px solid #1e3d59 !important; border: 1px solid #e2e8f0;">
                    <h4 class="fw-bold mb-1 fs-5">⚽ Alumnos de la Academia</h4>
                    <p class="text-muted small mb-3">Ingresa tu número de DNI para verificar asistencias y pagos.</p>
                    
                    <form method="post" asp-page-handler="Buscar" class="pt-3">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Ingresa tu DNI Registrado:</label>
                            <input type="text" asp-for="DniConsulta" class="form-control text-center py-2 fs-5" placeholder="Ingresa tu DNI" maxlength="8" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2" style="background-color: #1e3d59; border: none;">Consultar Ficha Deportiva 🔍</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.WhatsappUrl))
    {
        <div class="card p-3 text-center shadow-sm mx-auto" style="max-width: 500px; border-left: 5px solid #25D366; border-radius: 10px;">
            <h5 class="fw-bold" style="color: #128C7E;">🚀 ¡Inscripción Guardada!</h5>
            <p class="text-muted small">Haz clic abajo para formalizar el envío de tu ficha por WhatsApp.</p>
            <a href="@Model.WhatsappUrl" target="_blank" class="btn btn-success w-100 my-1 fw-bold btn-sm py-2" style="background-color: #25D366; border: none;">💬 Enviar Ficha por WhatsApp</a>
            <div class="mt-2"><a href="/" class="btn btn-link text-secondary btn-sm small">Volver al inicio</a></div>
        </div>
    }

    @if (Model.AccesoConcedido && string.IsNullOrEmpty(Model.WhatsappUrl))
    {
        <div class="card p-3 bg-white shadow-sm border rounded-3 mx-auto" style="max-width: 600px;">
            <h4 class="fw-bold text-dark border-bottom pb-2">⚽ Tu Ficha Deportiva</h4>
            <div class="row g-2 small mb-3">
                <div class="col-6"><strong>Nombres:</strong> @Model.AlumnoNombre</div>
                <div class="col-6"><strong>🪪 DNI:</strong> @Model.AlumnoDni</div>
                <div class="col-6"><strong>Celular:</strong> @Model.AlumnoCelular</div>
                <div class="col-6"><strong>Mensualidad:</strong> <span class="badge @(Model.AlumnoEstadoPago == "Al día" ? "bg-success" : "bg-danger")">@Model.AlumnoEstadoPago</span></div>
            </div>
            <div class="p-3 bg-light rounded border mb-3">
                <span class="fw-bold text-secondary d-block mb-1 small">Historial de Control de Asistencias:</span>
                <span class="text-primary fw-bold">@Model.AlumnoAsistencias</span>
            </div>
            <div class="text-center"><a href="/" class="btn btn-dark btn-sm px-4">Cerrar Sesión</a></div>
        </div>
    }

    @if (IndexModel.EsAdminSesion)
    {
        <div class="card p-3 shadow-sm border-0 bg-white" style="border-radius: 12px; border-top: 5px solid #6366f1 !important; border: 1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="fw-bold m-0 text-dark fs-5">👑 Panel de Control Real (Alessandro)</h4>
                <form method="post" asp-page-handler="CerrarAdmin">
                    <button type="submit" class="btn btn-danger btn-sm px-3">Cerrar Panel</button>
                </form>
            </div>

            <div class="card mb-4 bg-light border" style="border-radius: 8px;">
                <div class="card-header bg-dark text-white fw-bold py-2 small">
                    ➕ Insertar Alumno Manualmente (Quedará guardado en .db)
                </div>
                <div class="card-body p-3">
                    <form method="post" asp-page-handler="AgregarAlumnoManual">
                        <div class="row g-2">
                            <div class="col-sm-6 mb-1">
                                <label class="form-label fw-bold mb-0 small">Nombre Completo:</label>
                                <input type="text" asp-for="AdminManualNombre" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-sm-6 mb-1">
                                <label class="form-label fw-bold mb-0 small">DNI (Para el login):</label>
                                <input type="text" asp-for="AdminManualDni" class="form-control form-control-sm" maxlength="8" required />
                            </div>
                            <div class="col-sm-4 mb-1">
                                <label class="form-label fw-bold mb-0 small">Celular:</label>
                                <input type="text" asp-for="AdminManualCelular" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-6 col-sm-4 mb-1">
                                <label class="form-label fw-bold mb-0 small">Edad:</label>
                                <input type="number" asp-for="AdminManualEdad" class="form-control form-control-sm" min="18" required />
                            </div>
                            <div class="col-6 col-sm-4 mb-1">
                                <label class="form-label fw-bold mb-0 small">Control de Pago:</label>
                                <select asp-for="AdminManualEstadoPago" class="form-select form-select-sm">
                                    <option value="Al día">Al día</option>
                                    <option value="Deuda Pendiente">Deuda Pendiente</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold mt-2">⚡ Guardar e Inscribir Permanentemente</button>
                    </form>
                </div>
            </div>

            <h6 class="fw-bold text-success mb-2">📥 Solicitudes Nuevas por la Web</h6>
            <div class="table-responsive mb-4" style="max-height: 180px; border: 1px solid #eee;">
                <table class="table table-sm table-striped table-hover m-0" style="font-size: 0.8rem;">
                    <thead class="table-dark">
                        <tr>
                            <th>Postulante</th>
                            <th>Celular</th>
                            <th>Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ListaNuevosInscritos.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-2">No hay solicitudes nuevas en este momento.</td></tr>
                        }
                        else
                        {
                            @foreach (var nuevo in Model.ListaNuevosInscritos)
                            {
                                <tr>
                                    <td>
                                        <strong>@nuevo.Nombre</strong><br>
                                        <span class="text-muted" style="font-size: 0.72rem;">🪪 DNI: @nuevo.Dni | @nuevo.Edad años</span>
                                    </td>
                                    <td><a href="https://wa.me/@nuevo.Celular" target="_blank" class="text-decoration-none">🟢 @nuevo.Celular</a></td>
                                    <td class="text-muted">@nuevo.Fecha</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <h6 class="fw-bold text-primary mb-2">👥 Lista Oficial Guardada (SQLite)</h6>
            <div class="table-responsive" style="border: 1px solid #eee;">
                <table class="table table-sm align-middle m-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Alumno / Datos</th>
                            <th>Estado Pago</th>
                            <th>Asistencias</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListaAlumnos)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Nombre</strong><br>
                                    <span class="text-muted" style="font-size: 0.72rem;">🪪 DNI: @item.Dni | Cel: @item.Celular</span>
                                </td>
                                <td>
                                    <span class="badge @(item.EstadoPago == "Al día" ? "bg-success" : "bg-danger")" style="font-size: 0.7rem;">@item.EstadoPago</span>
                                </td>
                                <td>
                                    <span class="text-muted d-block" style="font-size: 0.72rem; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Asistencias</span>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="EliminarAlumno" asp-route-dni="@item.Dni" 
                                          onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente a @item.Nombre?');" 
                                          style="display:inline;">
                                        <button type="submit" class="btn btn-danger btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>